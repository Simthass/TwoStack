# Contact form: create an API key and verify the sending domain with Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional: use the site-specific pa-XXXXX.js URL shown in Plausible settings.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Create a Sanity project with a public dataset, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Only needed locally for the one-time import. Do not expose this in NEXT_PUBLIC variables.
SANITY_WRITE_TOKEN=
